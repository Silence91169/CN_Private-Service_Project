# Copy to config/inventory.env and replace every CHANGE_ME value.
# config/inventory.env is ignored by Git because it is machine/session specific.
PRIMARY_DNS_IP=CHANGE_ME
SECONDARY_DNS_IP=CHANGE_ME
PRIMARY_EDGE_IP=CHANGE_ME
STANDBY_EDGE_IP=CHANGE_ME
BACKEND_A_IP=CHANGE_ME
BACKEND_B_IP=CHANGE_ME
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
PRIMARY_EDGE_HTTP_PORT=8080
PRIMARY_EDGE_HTTPS_PORT=8443
STANDBY_EDGE_HTTP_PORT=8080
STANDBY_EDGE_HTTPS_PORT=8443
DNS_TTL=30
BACKEND_A_INTERFACE=en0
BACKEND_B_INTERFACE=en0
HOMEBREW_PREFIX=/opt/homebrew

# Paths are local to each edge and must point outside this repository.
TLS_CERT_PATH=/CHANGE_ME/app.team1.test.crt
TLS_KEY_PATH=/CHANGE_ME/app.team1.test.key
