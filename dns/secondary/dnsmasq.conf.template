# Team 1 secondary DNS — must carry the same active records as primary.
port=53
bind-interfaces
listen-address=127.0.0.1,__SECONDARY_DNS_IP__
local=/team1.test/
local-ttl=__DNS_TTL__
addn-hosts=__HOMEBREW_PREFIX__/etc/team1-secondary.hosts
no-resolv
server=1.1.1.1
server=8.8.8.8
cache-size=1000
log-queries
log-facility=__HOMEBREW_PREFIX__/var/log/team1-dns-secondary.log
