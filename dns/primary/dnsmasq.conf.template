# Team 1 primary DNS — rendered file, not installed automatically.
port=53
bind-interfaces
listen-address=127.0.0.1,__PRIMARY_DNS_IP__
local=/team1.test/
local-ttl=__DNS_TTL__
addn-hosts=__HOMEBREW_PREFIX__/etc/team1-primary.hosts
no-resolv
server=1.1.1.1
server=8.8.8.8
cache-size=1000
log-queries
log-facility=__HOMEBREW_PREFIX__/var/log/team1-dns-primary.log
